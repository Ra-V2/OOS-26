<div class="container">
    <h1>Edit Category</h1>

    <form action="/web/categories/#(category.id)/update" method="POST">
        <label>Name</label>
        <input name="name" value="#(category.name)" />

        <button class="btn" type="submit">Update</button>
    </form>
</div>