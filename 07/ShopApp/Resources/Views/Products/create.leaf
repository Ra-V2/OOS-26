<link rel="stylesheet" href="/styles.css">

<div class="nav">
    <div class="nav-left">
        <b>ShopApp</b>
    </div>

    <div class="nav-right">
        <a href="/web/products">Products</a>
        <a href="/web/categories">Categories</a>
    </div>
</div>

<div class="container">
    <h1>Create Product</h1>

    <form action="/web/products" method="POST">
        <label>Name</label>
        <input name="name" />

        <label>Price</label>
        <input name="price" />

        <label>Category</label>
        <select name="categoryID">
            #for(category in categories):
                <option value="#(category.id)">#(category.name)</option>
            #endfor
        </select>

        <button class="btn" type="submit">Create</button>
    </form>
</div>