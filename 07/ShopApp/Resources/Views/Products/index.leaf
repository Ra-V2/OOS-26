<link rel="stylesheet" href="/styles.css">

<div class="nav">
    <div class="nav-left">
        <b>ShopApp</b>
    </div>

    <div class="nav-right">
        <a href="/web/products">Products</a>
        <a href="/web/categories">Categories</a>
    </div>
</div>

<div class="container">

    <div class="header">
        <h1>Products</h1>
        <a class="btn" href="/web/products/new">+ Create Product</a>
    </div>

    #for(product in products):
        <div class="card">
            <div>
                <b>#(product.name)</b><br>
                <small>$#(product.price)</small><br>

                <span class="badge">
                    #(product.category.name)
                </span>
            </div>

            <div>
                <a class="btn-edit" href="/web/products/#(product.id)/edit">Edit</a>

                <form action="/web/products/#(product.id)/delete"
                    method="POST"
                    style="display:inline;">
                    <button class="btn-delete">Delete</button>
                </form>
            </div>
        </div>
    #endfor

</div>